<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!--
        Enterprise log line: UTC timestamp, explicit level, the originating
        method (set by the logging aspect via MDC), and journey correlation ids.
    -->
    <property name="LOG_PATTERN"
              value="%d{yyyy-MM-dd'T'HH:mm:ss.SSS'Z',UTC} level=%-5level method=%X{method:-N/A} correlationId=%X{correlationId:-N/A} transactionId=%X{transactionId:-N/A} logger=%logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
